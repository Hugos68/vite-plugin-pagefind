{
  "name": "vite-plugin-pagefind",
  "version": "1.1.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hugos68/vite-plugin-pagefind.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.mts",
        "default": "./dist/types.mjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "oxfmt .",
    "lint": "oxlint .",
    "build": "tsdown",
    "prepack": "tsdown"
  },
  "dependencies": {
    "colorette": "^2.0.20",
    "package-manager-detector": "^1.9.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.4",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.3"
  },
  "peerDependencies": {
    "vite": ">=4.0.0"
  },
  "engines": {
    "node": "26.x",
    "pnpm": "12.x"
  },
  "packageManager": "pnpm@12.10.1"
}
